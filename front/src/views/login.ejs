<%- include('partials/header') %>

<section class="card card-narrow">
  <h2>Connexion</h2>

  <% if (registered) { %>
    <p class="form-success">Compte créé, vous pouvez vous connecter.</p>
  <% } %>
  <% if (googleError) { %>
    <p class="form-error form-error-top" role="alert">La connexion avec Google a échoué, réessayez.</p>
  <% } %>
  <% if (githubError) { %>
    <p class="form-error form-error-top" role="alert">La connexion avec GitHub a échoué, réessayez.</p>
  <% } %>

  <form data-endpoint="/api/login" data-redirect="/" class="form">
    <input type="email" name="email" placeholder="Email" autocomplete="email" required>
    <input type="password" name="password" placeholder="Mot de passe (8 caractères minimum)" autocomplete="current-password" minlength="8" required>
    <p class="form-error" role="alert" hidden></p>
    <button type="submit" class="btn">Se connecter</button>
  </form>

  <%# de vrais liens (pas des fetch) : le navigateur doit partir sur la page du fournisseur %>
  <a href="/api/google" class="btn btn-google">Continuer avec Google</a>
  <a href="/api/github" class="btn btn-github">Continuer avec GitHub</a>

  <a href="/register" class="link">Créer un compte</a>
</section>

<%- include('partials/footer') %>